# Root allowlist: keep unrelated local material out of this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/docs/
!/.github/
!/fusion/
!/host/
!/sensors/
!/camera/
!/task2_ai/

# Only baseline fixtures needed by fusion tests / verification / loading.
/sensors/*
!/sensors/ir_thermal_hdmi_v3_20260930/
/sensors/ir_thermal_hdmi_v3_20260930/*
!/sensors/ir_thermal_hdmi_v3_20260930/tests/
