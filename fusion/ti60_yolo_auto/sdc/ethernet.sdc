# PHY RX clock is also the gigabit transmit clock; no extra PLL.
create_clock -period 8.000 -name rxc [get_ports {rxc}]
# APB packet RAM and request/ack mailbox cross asynchronously.
set_clock_groups -asynchronous -group [get_clocks {rxc}]
# Output budgets generated by Efinity Interface Designer for these exact pads.
# They constrain the fabric-to-DDIO paths; PHY/PCB delay remains a board test.
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~195}] -max 0.302 [get_ports {mdc_o}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~195}] -min -0.140 [get_ports {mdc_o}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~15}] -max 0.302 [get_ports {tx_en_o_LO tx_en_o_HI}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~15}] -min -0.140 [get_ports {tx_en_o_LO tx_en_o_HI}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~130}] -max 0.302 [get_ports {txc_lo_o txc_hi_o}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~130}] -min -0.140 [get_ports {txc_lo_o txc_hi_o}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~114}] -max 0.302 [get_ports {txd_lo_o[0] txd_hi_o[0]}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~114}] -min -0.140 [get_ports {txd_lo_o[0] txd_hi_o[0]}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~97}] -max 0.302 [get_ports {txd_lo_o[1] txd_hi_o[1]}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~97}] -min -0.140 [get_ports {txd_lo_o[1] txd_hi_o[1]}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~171}] -max 0.302 [get_ports {txd_lo_o[2] txd_hi_o[2]}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~171}] -min -0.140 [get_ports {txd_lo_o[2] txd_hi_o[2]}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~181}] -max 0.302 [get_ports {txd_lo_o[3] txd_hi_o[3]}]
set_output_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~181}] -min -0.140 [get_ports {txd_lo_o[3] txd_hi_o[3]}]

# Added PHY RX DDIO fabric budgets from the matching source pads.
set_input_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~146}] -max 0.476 [get_ports {rx_dv_LO rx_dv_HI}]
set_input_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~146}] -min 0.276 [get_ports {rx_dv_LO rx_dv_HI}]
set_input_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~129}] -max 0.476 [get_ports {rxd_lo_i[0] rxd_hi_i[0]}]
set_input_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~129}] -min 0.276 [get_ports {rxd_lo_i[0] rxd_hi_i[0]}]
set_input_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~113}] -max 0.476 [get_ports {rxd_lo_i[1] rxd_hi_i[1]}]
set_input_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~113}] -min 0.276 [get_ports {rxd_lo_i[1] rxd_hi_i[1]}]
set_input_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~12}] -max 0.476 [get_ports {rxd_lo_i[2] rxd_hi_i[2]}]
set_input_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~12}] -min 0.276 [get_ports {rxd_lo_i[2] rxd_hi_i[2]}]
set_input_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~96}] -max 0.476 [get_ports {rxd_lo_i[3] rxd_hi_i[3]}]
set_input_delay -clock rxc -reference_pin [get_ports {rxc~CLKOUT~1~96}] -min 0.276 [get_ports {rxd_lo_i[3] rxd_hi_i[3]}]
